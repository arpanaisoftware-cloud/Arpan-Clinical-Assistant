            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"John Doe\",\n  \"email\": \"john@example.com\",\n  \"password\": \"password123\",\n  \"staffId\": \"STF001\",\n  \"department\": \"Cardiology\",\n  \"role\": \"Doctor\",\n  \"modulePermissions\": \"Full Access\"\n}",
              "options": {"raw": {"language": "json"}}
            },
            "url": {
              "raw": "{{baseUrl}}/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "register"]
            }
          },
          "response": [
            {
              "name": "Success",
              "status": "Created",
              "code": 201,
              "_postman_previewlanguage": "json",
              "header": [{"key": "Content-Type", "value": "application/json"}],
              "body": "{\n  \"message\": \"User created successfully\",\n  \"user\": {\n    \"id\": \"64b2c123abc4567890def123\",\n    \"name\": \"John Doe\",\n    \"email\": \"john@example.com\"\n  }\n}"
